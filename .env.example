# Baymax assistant environment variables
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# The real shell environment always wins over this file.

# ------------------------------------------------------------
# Tavily API key for primary web search.
# Get a key at https://tavily.com/
TAVILY_API_KEY=your_key_here

# SearXNG is used if Tavily is unavailable or has no usable results.
